generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DELETED

  @@map("account_status")
}

enum RoleName {
  GUEST
  HOST
  SELLER
  DRIVER
  ADMIN
  SUPPORT

  @@map("role_name")
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  PAUSED
  EXPIRED

  @@map("listing_status")
}

enum IdDocumentStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED

  @@map("id_document_status")
}

enum AvailabilityStatus {
  BLOCKED
  AVAILABLE

  @@map("availability_status")
}

enum ListingDivision {
  STAYS
  RENTALS
  BUY
  CARS
  MARKETPLACE
  NEW_CONSTRUCTION

  @@map("listing_division")
}

enum BookingStatus {
  DRAFT
  REQUESTED
  PAYMENT_PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  DISPUTED

  @@map("booking_status")
}

enum PaymentStatus {
  PENDING_PROOF
  PENDING_ADMIN_REVIEW
  APPROVED
  REJECTED
  REFUNDED

  @@map("payment_status")
}

enum WalletEntryType {
  CREDIT
  DEBIT
  HOLD
  RELEASE
  REFUND

  @@map("wallet_entry_type")
}

enum GiftStatus {
  CREATED
  SENT
  CLAIM_PENDING
  CLAIMED
  LOCKED
  EXPIRED
  ADMIN_BLOCKED

  @@map("gift_status")
}

enum RideStatus {
  DRAFT
  REQUESTED
  MATCHING
  DRIVER_ASSIGNED
  DRIVER_ARRIVING
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@map("ride_status")
}

enum MessageSenderRole {
  GUEST
  HOST
  ADMIN
  SUPPORT

  @@map("message_sender_role")
}

model User {
  id           String        @id @default(uuid())
  email        String?       @unique
  phoneHash    String?       @unique @map("phone_hash")
  passwordHash String?       @map("password_hash")
  displayName  String        @map("display_name")
  locale       String        @default("ar-SY")
  status       AccountStatus @default(ACTIVE)
  idDocumentRef String?      @map("id_document_ref")
  idDocumentSubmittedAt DateTime? @map("id_document_submitted_at")
  idDocumentMimeType String? @map("id_document_mime_type")
  idDocumentStatus IdDocumentStatus? @map("id_document_status")
  idDocumentReviewedById String? @map("id_document_reviewed_by_id")
  idDocumentReviewedAt DateTime? @map("id_document_reviewed_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  roles             UserRole[]
  sellerProfile     SellerProfile?
  driverProfile     DriverProfile?
  listings          Listing[]         @relation("ListingOwner")
  bookings          Booking[]         @relation("BookingGuest")
  wallets           Wallet[]
  sentGifts         WalletGift[]      @relation("GiftSender")
  claimedGifts      WalletGift[]      @relation("GiftRecipient")
  rideRequests      RideRequest[]     @relation("RideRider")
  driverRideMatches RideRequest[]     @relation("RideDriver")
  auditLogs         AdminAuditLog[]   @relation("AuditActor")
  listingReviews    ListingReview[]   @relation("ReviewGuest")
  sentMessages      Message[]         @relation("MessageSender")
  paymentProofs     PaymentProof[]    @relation("PaymentPayer")
  listingInquiries  MessageThread[]   @relation("ListingInquiryGuest")

  @@map("users")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  role      RoleName
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([role])
  @@map("user_roles")
}

model SellerProfile {
  id             String        @id @default(uuid())
  userId         String        @unique @map("user_id")
  legalName      String        @map("legal_name")
  sellerType     String        @map("seller_type")
  documentStatus ListingStatus @default(DRAFT) @map("document_status")
  planCode       String?       @map("plan_code")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("seller_profiles")
}

model DriverProfile {
  id              String   @id @default(uuid())
  userId          String   @unique @map("user_id")
  licenseHash     String?  @map("license_hash")
  vehicleMake     String?  @map("vehicle_make")
  vehicleModel    String?  @map("vehicle_model")
  vehiclePlate    String?  @map("vehicle_plate")
  active          Boolean  @default(false)
  lastLocationGeo Unsupported("geometry(Point,4326)")? @map("last_location_geo")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("driver_profiles")
}

model Location {
  id          String   @id @default(uuid())
  country    String   @default("SY")
  governorate String
  city        String
  area        String?
  street      String?
  addressLine String?  @map("address_line")
  geo         Unsupported("geometry(Point,4326)")?
  createdAt   DateTime @default(now()) @map("created_at")

  listings       Listing[]
  pickupRides    RideRequest[] @relation("RidePickup")
  dropoffRides   RideRequest[] @relation("RideDropoff")

  @@index([governorate, city])
  @@map("locations")
}

model Listing {
  id          String          @id @default(uuid())
  ownerId     String          @map("owner_id")
  locationId  String?         @map("location_id")
  division    ListingDivision
  titleAr     String          @map("title_ar")
  titleEn     String?         @map("title_en")
  description String?
  status      ListingStatus   @default(DRAFT)
  priceMinor  Int             @map("price_minor")
  currency    String          @default("SYP")
  instantBookEnabled Boolean  @default(false) @map("instant_book_enabled")
  expiresAt   DateTime?       @map("expires_at")
  metadata    Json            @default("{}")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  owner          User                  @relation("ListingOwner", fields: [ownerId], references: [id])
  location       Location?             @relation(fields: [locationId], references: [id])
  media          ListingMedia[]
  bookings       Booking[]
  availability   ListingAvailability[]
  reviews        ListingReview[]
  inquiryThreads MessageThread[]

  @@index([division, status])
  @@index([ownerId])
  @@map("listings")
}

model ListingAvailability {
  id                 String              @id @default(uuid())
  listingId          String              @map("listing_id")
  date               DateTime            @db.Date
  status             AvailabilityStatus  @default(BLOCKED)
  priceOverrideMinor Int?                @map("price_override_minor")
  note               String?
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, date])
  @@index([listingId, date])
  @@map("listing_availability")
}

model ListingMedia {
  id        String   @id @default(uuid())
  listingId String   @map("listing_id")
  url       String
  kind      String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@map("listing_media")
}

model Booking {
  id          String        @id @default(uuid())
  listingId   String        @map("listing_id")
  guestId     String        @map("guest_id")
  status      BookingStatus @default(REQUESTED)
  checkIn     DateTime?     @map("check_in")
  checkOut    DateTime?     @map("check_out")
  amountMinor Int           @map("amount_minor")
  currency    String        @default("SYP")
  metadata    Json          @default("{}")
  guestCheckedInAt  DateTime? @map("guest_checked_in_at")
  guestCheckedOutAt DateTime? @map("guest_checked_out_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  listing  Listing       @relation(fields: [listingId], references: [id])
  guest    User          @relation("BookingGuest", fields: [guestId], references: [id])
  payments PaymentProof[]
  paymentIntents PaymentIntent[]
  paymentEvents PaymentEvent[]
  review   ListingReview?
  messageThread MessageThread?

  @@index([guestId, status])
  @@index([listingId, status])
  @@map("bookings")
}

model PaymentProof {
  id              String        @id @default(uuid())
  bookingId       String?       @map("booking_id")
  userId          String        @map("user_id")
  provider        String
  status          PaymentStatus @default(PENDING_PROOF)
  amountMinor     Int           @map("amount_minor")
  currency        String        @default("SYP")
  proofAssetUrl   String?       @map("proof_asset_url")
  // Full set of uploaded evidence files (seller-plan/advertising submissions can carry several —
  // ownership proof, license, photos). proofAssetUrl stays populated with the first one for
  // backward compatibility with every existing single-file consumer (Stripe, local-wallet, etc.,
  // which only ever have one); this is the complete list admin should actually review.
  proofAssetUrls  String[]      @default([]) @map("proof_asset_urls")
  providerRef     String?       @map("provider_ref")
  adminNote       String?       @map("admin_note")
  reviewedById    String?       @map("reviewed_by_id")
  reviewedAt      DateTime?     @map("reviewed_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  booking Booking? @relation(fields: [bookingId], references: [id])
  payer   User     @relation("PaymentPayer", fields: [userId], references: [id])

  // A given provider reference may be submitted only once. Postgres treats NULLs as distinct, so
  // internally-generated proofs without a providerRef are unaffected; this closes the TOCTOU race
  // where two concurrent submissions with the same reference could both create a proof.
  @@unique([provider, providerRef], map: "payment_proofs_provider_provider_ref_key")
  @@index([status, createdAt])
  @@index([userId])
  @@map("payment_proofs")
}

model ListingReview {
  id              String    @id @default(uuid())
  listingId       String    @map("listing_id")
  bookingId       String    @unique @map("booking_id")
  guestId         String    @map("guest_id")
  rating          Int
  comment         String?
  hiddenAt        DateTime? @map("hidden_at")
  hiddenByAdminId String?   @map("hidden_by_admin_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  guest   User    @relation("ReviewGuest", fields: [guestId], references: [id])

  @@index([listingId, hiddenAt])
  @@map("listing_reviews")
}

model MessageThread {
  id        String   @id @default(uuid())
  bookingId String?  @unique @map("booking_id")
  listingId String?  @map("listing_id")
  guestId   String?  @map("guest_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  booking  Booking?  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  listing  Listing?  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  guest    User?     @relation("ListingInquiryGuest", fields: [guestId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([listingId, guestId])
  @@map("message_threads")
}

model Message {
  id           String            @id @default(uuid())
  threadId     String            @map("thread_id")
  senderUserId String            @map("sender_user_id")
  senderRole   MessageSenderRole @map("sender_role")
  body         String
  createdAt    DateTime          @default(now()) @map("created_at")

  thread MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender User          @relation("MessageSender", fields: [senderUserId], references: [id])

  @@index([threadId, createdAt])
  @@map("messages")
}

model Wallet {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  currency          String   @default("SYP")
  cachedBalanceMinor Int     @default(0) @map("cached_balance_minor")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries WalletEntry[]

  @@unique([userId, currency])
  @@map("wallets")
}

model WalletEntry {
  id              String          @id @default(uuid())
  walletId        String          @map("wallet_id")
  type            WalletEntryType
  amountMinor     Int             @map("amount_minor")
  currency        String          @default("SYP")
  referenceType   String          @map("reference_type")
  referenceId     String          @map("reference_id")
  idempotencyKey  String          @unique @map("idempotency_key")
  note            String?
  createdAt       DateTime        @default(now()) @map("created_at")

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)

  @@index([walletId, createdAt])
  @@index([referenceType, referenceId])
  @@map("wallet_entries")
}

model WalletGift {
  id                     String     @id @default(uuid())
  senderUserId            String     @map("sender_user_id")
  recipientUserId         String?    @map("recipient_user_id")
  recipientPhoneHash      String     @map("recipient_phone_hash")
  amountMinor             Int        @map("amount_minor")
  currency                String     @default("SYP")
  message                 String?
  status                  GiftStatus @default(CREATED)
  claimAttemptCount       Int        @default(0) @map("claim_attempt_count")
  lockedUntil             DateTime?  @map("locked_until")
  expiresAt               DateTime   @map("expires_at")
  createdAt               DateTime   @default(now()) @map("created_at")
  updatedAt               DateTime   @updatedAt @map("updated_at")

  sender    User  @relation("GiftSender", fields: [senderUserId], references: [id])
  recipient User? @relation("GiftRecipient", fields: [recipientUserId], references: [id])

  @@index([recipientPhoneHash, status])
  @@index([senderUserId, createdAt])
  @@map("wallet_gifts")
}

// Electronic payment intent (card/provider path). Server-authoritative amount + currency; the
// client can never declare success — status only advances via a cryptographically verified
// provider webhook. Distinct from manual PaymentProof (Sham Cash / local wallet / bank transfer)
// and from WalletGift (platform-funded promotional credit).
model PaymentIntent {
  id           String         @id @default(uuid())
  userId       String         @map("user_id")
  reference    String         @unique
  amountMinor  Int            @map("amount_minor")
  currency     String
  status       PaymentIntentStatus @default(REQUIRES_PAYMENT)
  provider     String         @default("stripe")
  providerRef  String?        @map("provider_ref")
  bookingId    String?        @map("booking_id")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  booking Booking?       @relation(fields: [bookingId], references: [id])
  events  PaymentEvent[]

  @@index([userId])
  @@index([bookingId])
  @@map("payment_intents")
}

// Auditable, idempotent provider event history. providerEventId is unique, so a duplicate/replayed
// webhook delivery is a no-op at the intake layer. processingStatus/attempts/lastError track our
// own handling of a delivery SEPARATELY from PaymentIntent.status (the business state) — a webhook
// can be durably "received" even when applying its booking/wallet side effects fails and rolls back,
// which is exactly the case this split exists to make visible instead of silently vanishing.
model PaymentEvent {
  id               String                       @id @default(uuid())
  // Which webhook rail produced this event -- 'payment_intent' (the events below reference intent)
  // or 'stripe_checkout' (the events below reference booking instead). Traceability is guaranteed by
  // providerReference (below) being required, not by a rail-conditional CHECK -- migration 017's
  // CHECK on original_intent_id/original_booking_id was dropped in migration 018, since it was too
  // strict once durable intake had to succeed even for an unresolvable local reference.
  rail             String
  // Structural authentication identity, NOT the money-movement-approval question (that stays
  // APPROVED_PROVIDER_CONFIGS in payment-policy.mjs) -- e.g. 'stripe' or 'sandbox'. Permanent: never
  // cleared by any deletion, unlike intentId/bookingId below.
  provider         String
  // A static, per-rail configuration label (e.g. 'sandbox-test-account', 'stripe-checkout') -- part
  // of the canonical event identity (migration 018) that replaces the old provider-blind global
  // uniqueness on providerEventId alone. Named honestly (migration 019, renamed from
  // providerAccount): this is NOT an identity derived from any verified provider/account context --
  // this codebase has no multi-account or Stripe Connect support, so there is only ever one possible
  // value per rail. If real multi-account support is ever added, this field must be derived from the
  // verified account context at that time (e.g. Stripe Connect's event.account), never a literal.
  providerEndpointKey String                     @map("provider_endpoint_key")
  // policyEnvironment() at receipt time (e.g. 'development', 'production'). 'unknown' for rows
  // received before this column existed (migration 017's backfill) -- an honest gap, not a guess.
  // PLAIN INFORMATIONAL METADATA ONLY (migration 020) -- deliberately NOT part of the canonical event
  // identity. It was, until independent review correctly found that using a mutable, ambient runtime
  // label (process.env.NODE_ENV) as part of an identity key let the exact same event delivered to the
  // exact same endpoint under two different environment labels (a deploy config change, or two
  // processes with different NODE_ENV, e.g. a test script vs the live server it drives) create two
  // independent rows and be applied twice -- confirmed as a real, already-manifested defect in this
  // codebase's own data, not just a theoretical one (see migration 020's comment). providerEndpointKey
  // already uniquely identifies the endpoint/mode in this codebase (there is exactly one static
  // endpoint key per rail today), so environment added no genuine distinguishing identity information
  // on top of it and is never used to fork identity again.
  environment      String
  // What kind of internal record this event was originally about -- 'PAYMENT_INTENT' or 'BOOKING'.
  // Permanent, set once at receipt, independent of whether intentId/bookingId later become null.
  subjectType      String                       @map("subject_type")
  // The RAW, unvalidated local reference from the payload (an intent's own `reference` string for
  // the payment_intent rail; `metadata.bookingId` for stripe_checkout) -- populated UNCONDITIONALLY
  // at intake, before any local lookup is attempted. This is what lets an authenticated event with
  // an unresolvable, malformed, or since-deleted local reference still be durably stored (migration
  // 018, closing a real "authenticated events silently dropped before persistence" defect an
  // independent review found). Immutable once set -- part of the conflict-detection comparison.
  providerReference String                      @map("provider_reference")
  // LIVE foreign keys -- nullable, ON DELETE SET NULL (migration 017; previously CASCADE on intent
  // and undeclared/NO ACTION on booking -- both wrong for a durable audit table, fixed after
  // independent review found this exact defect). Deleting the parent clears these, NOT the event row.
  // Populated once local resolution (via providerReference) succeeds -- may be null at intake time
  // and filled in by a later processing step, not necessarily set atomically with the row's creation.
  intentId         String?                      @map("intent_id")
  bookingId        String?                      @map("booking_id")
  // PERMANENT snapshots of the same two ids, populated once resolution succeeds and NEVER cleared by
  // any deletion -- what makes an orphaned event (its live FK now null) still fully self-describing
  // and reconcilable. "Where available" per rail: payment_intent rows populate originalIntentId
  // once resolved, and originalBookingId when the resolved intent had one; stripe_checkout rows
  // populate originalBookingId only (this rail has no PaymentIntent to reference at all).
  originalIntentId  String?                     @map("original_intent_id")
  originalBookingId String?                     @map("original_booking_id")
  // No longer independently unique -- see the partial unique index migration 021 creates (not
  // representable as a Prisma @@unique, since it is scoped to canonical rows only -- see
  // supersededByEventId below). A bare provider-event-id string is only unique WITHIN one
  // provider/endpoint among CANONICAL rows; the same string from a different provider must never
  // collide with it, and a superseded historical duplicate legitimately shares it with its survivor.
  // NEVER rewritten once set, for any reason, including duplicate resolution (migration 021 -- an
  // earlier version of migration 020 rewrote a losing duplicate's value here, which independent
  // review correctly found destroyed the provider's own evidence; that rewrite was undone).
  providerEventId  String                       @map("provider_event_id")
  type             String
  amountMinor      Int?                         @map("amount_minor")
  currency         String?
  // The provider's own object id (e.g. a charge/payment-intent id from event.data.object.id).
  // Non-sensitive metadata, stored alongside amountMinor/currency for the same reason: it lets an
  // admin replay reconstruct the event snapshot without needing (or storing) the raw webhook payload.
  providerObjectId String?                      @map("provider_object_id")
  // SHA-256 of the raw, already-signature-verified webhook body. Never the raw payload itself.
  payloadDigest    String?                      @map("payload_digest")
  processingStatus PaymentEventProcessingStatus @default(RECEIVED) @map("processing_status")
  attempts         Int                          @default(0)
  lastAttemptAt    DateTime?                    @map("last_attempt_at")
  lastError        String?                      @map("last_error")
  appliedAt        DateTime?                     @map("applied_at")
  receivedAt       DateTime                      @default(now()) @map("received_at")
  // Claim ownership for the apply phase (migration 021). NULL means no active claim. A claim is a
  // random per-attempt identity (applyPaymentEvent() mints a fresh one every time it wins the CAS
  // race) plus a bounded expiry -- what makes a crashed/killed/disconnected worker's stuck APPLYING
  // row safely reclaimable by a LATER call instead of lost forever (independent review found the
  // prior CAS-only claim, with no token or expiry, had no recovery path at all: APPLYING is excluded
  // from CLAIMABLE_STATUSES by design, so nothing could ever reclaim a row stuck there). Every write
  // this event's own apply() closure or applyPaymentEvent()'s own success/failure handling makes is
  // bound to the exact token it was issued -- a stale worker that wakes up after its claim expired and
  // a newer claimant has already taken over matches zero rows on its own write, never corrupting the
  // newer claimant's state. Cleared to null on every terminal outcome (APPLIED/IGNORED/FAILED/
  // DEAD_LETTERED).
  claimToken       String?                      @map("claim_token")
  claimExpiresAt   DateTime?                    @map("claim_expires_at")
  // Duplicate-resolution (migration 021), NOT the conflict-audit relation below -- a fundamentally
  // different concept. A PaymentEventConflict record documents a REDELIVERY whose CONTENT didn't
  // match an existing row (no second full row is ever created for that). supersededByEventId instead
  // records that THIS entire, independently-durable row and another row are the SAME real event,
  // discovered identical only after the fact (e.g. migration 020's environment-forking bug durably
  // stored the one real event as two full historical rows before that bug was fixed) -- both rows keep
  // their own complete lifecycle (attempts/status/timestamps) and their real, unaltered
  // providerEventId; this column just records which one is canonical going forward and NEVER rewrites
  // either row's provider-originated data to do so. RESTRICT (not SET NULL/CASCADE like intent/
  // booking): a canonical row must never be deletable while a superseded duplicate still points to it.
  supersededByEventId String?  @map("superseded_by_event_id")
  supersededAt         DateTime? @map("superseded_at")
  supersededReason     String?   @map("superseded_reason")

  intent  PaymentIntent? @relation(fields: [intentId], references: [id], onDelete: SetNull)
  booking Booking?       @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  // Append-only record of every conflicting delivery under this event's canonical identity (same
  // (provider, providerEndpointKey, providerEventId), different immutable content). This event row's
  // own fields (processingStatus/lastError/attempts/etc.) are NEVER written on a conflict -- see
  // intakeEvent() in payment-event-pipeline.mjs and this relation's own model comment.
  conflicts PaymentEventConflict[]
  supersededByEvent    PaymentEvent?  @relation("PaymentEventSupersession", fields: [supersededByEventId], references: [id], onDelete: Restrict)
  supersededDuplicates PaymentEvent[] @relation("PaymentEventSupersession")

  // Uniqueness among CANONICAL (non-superseded) rows only is enforced by a raw PARTIAL unique index
  // (migration 021, name payment_events_identity_key kept for isPaymentEventIdentityConflict()'s
  // P2002 target check) -- NOT representable here as a Prisma @@unique, since @@unique has no WHERE
  // clause support and a superseded historical duplicate legitimately shares its identity triple with
  // its survivor. Lookups use findFirst scoped to supersededByEventId: null (see intakeEvent()), not
  // findUnique against a compound key Prisma itself cannot actually guarantee is unique table-wide.
  @@index([provider, providerEndpointKey, providerEventId])
  @@index([providerEventId])
  @@index([supersededByEventId])
  @@index([intentId])
  @@index([rail])
  @@index([bookingId])
  @@index([processingStatus])
  @@map("payment_events")
}

// Append-only audit trail of conflicting deliveries — a delivery whose canonical identity
// (provider, providerEndpointKey, providerEventId) matches an existing PaymentEvent but whose
// immutable content (payload digest, type, reference, subject, amounts) does not. Recording
// this here, in a separate child table, is what makes it structurally impossible for a conflicting
// delivery to ever overwrite the original event's own authoritative outcome (independent review
// found intakeEvent() doing exactly that in the prior round — this table is the fix). Stores only
// non-sensitive, already-authenticated metadata: a digest and the immutable-field snapshot, never
// the raw payload, never secrets.
model PaymentEventConflict {
  id                String   @id @default(uuid())
  paymentEventId    String   @map("payment_event_id")
  receivedAt        DateTime @default(now()) @map("received_at")
  payloadDigest     String   @map("payload_digest")
  type              String
  providerReference String   @map("provider_reference")
  subjectType       String   @map("subject_type")
  providerObjectId  String?  @map("provider_object_id")
  amountMinor       Int?     @map("amount_minor")
  currency          String?

  event PaymentEvent @relation(fields: [paymentEventId], references: [id], onDelete: Cascade)

  @@index([paymentEventId])
  @@map("payment_event_conflicts")
}

enum PaymentIntentStatus {
  REQUIRES_PAYMENT
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELED
  REFUNDED

  @@map("payment_intent_status")
}

// Our own handling of one webhook delivery (or an admin replay of it) — distinct from
// PaymentIntentStatus, which is the business state the provider reports. RECEIVED: durably
// persisted, not yet attempted. APPLYING: an attempt is in flight (observability only, not a lock —
// real safety is the unique constraints applyPaymentEvent relies on). APPLIED: side effects
// committed (or none were needed). IGNORED: a legal-but-no-op or an out-of-order/illegal transition
// — retrying would not change the outcome. FAILED: an attempt threw; eligible for retry via
// redelivery or admin replay. DEAD_LETTERED: failed attempts reached the threshold; needs a human.
enum PaymentEventProcessingStatus {
  RECEIVED
  APPLYING
  APPLIED
  IGNORED
  FAILED
  DEAD_LETTERED
  // Authenticated but locally unresolvable: an unknown/malformed local reference, an amount/currency
  // conflict against the resolved local record, or a genuine identity conflict on redelivery
  // (same canonical identity, different immutable fields). Migration 018.
  QUARANTINED
  // The webhook_apply policy denied application. A real, queryable status -- previously this case
  // silently left the row at RECEIVED, which conflated "not yet attempted" with "explicitly
  // deferred by policy". Migration 018.
  POLICY_DEFERRED

  @@map("payment_event_processing_status")
}

// Records a user's acceptance of a specific legal-document VERSION. The document text itself is
// owner/legal-supplied (see server/lib/legal.mjs manifest) — this only binds consent to a version
// so re-consent can be required when a document is republished.
model LegalConsent {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  documentKey String   @map("document_key")
  version     String
  acceptedAt  DateTime @default(now()) @map("accepted_at")

  @@unique([userId, documentKey, version])
  @@index([userId])
  @@map("legal_consents")
}

enum VerificationStatus {
  PENDING
  VERIFIED
  EXPIRED
  LOCKED
  CANCELLED

  @@map("verification_status")
}

// Server-authoritative phone/identity verification (OTP). Codes are generated, hashed, sent, and
// verified entirely on the backend. The plaintext code is never stored or returned to production
// clients. (Table + enum already existed in the DB ahead of the schema; this models them.)
model VerificationCode {
  id                String             @id @default(uuid())
  identifierHash    String             @map("identifier_hash")
  purpose           String
  codeHash          String             @map("code_hash")
  status            VerificationStatus @default(PENDING)
  attempts          Int                @default(0)
  maxAttempts       Int                @default(5) @map("max_attempts")
  expiresAt         DateTime           @map("expires_at")
  sentProvider      String?            @map("sent_provider")
  providerMessageId String?            @map("provider_message_id")
  verifiedAt        DateTime?          @map("verified_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  channel           String             @default("sms")

  @@index([identifierHash, purpose, status])
  @@index([expiresAt])
  @@index([channel])
  @@map("verification_codes")
}

model OtpAttemptLock {
  id             String   @id @default(uuid())
  purpose        String
  subjectHash    String   @map("subject_hash")
  attemptCount   Int      @default(0) @map("attempt_count")
  lockedUntil    DateTime? @map("locked_until")
  lastAttemptAt  DateTime? @map("last_attempt_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([purpose, subjectHash])
  @@map("otp_attempt_locks")
}

model RideRequest {
  id              String     @id @default(uuid())
  riderId          String     @map("rider_id")
  driverId         String?    @map("driver_id")
  pickupLocationId String?    @map("pickup_location_id")
  dropoffLocationId String?   @map("dropoff_location_id")
  status          RideStatus @default(REQUESTED)
  requestedAt     DateTime   @default(now()) @map("requested_at")
  fareMinor       Int?       @map("fare_minor")
  currency        String     @default("SYP")
  pickupGeo       Unsupported("geometry(Point,4326)")? @map("pickup_geo")
  dropoffGeo      Unsupported("geometry(Point,4326)")? @map("dropoff_geo")
  metadata        Json       @default("{}")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  rider          User      @relation("RideRider", fields: [riderId], references: [id])
  driver         User?     @relation("RideDriver", fields: [driverId], references: [id])
  pickupLocation Location? @relation("RidePickup", fields: [pickupLocationId], references: [id])
  dropoffLocation Location? @relation("RideDropoff", fields: [dropoffLocationId], references: [id])

  @@index([status, requestedAt])
  @@index([driverId, status])
  @@map("ride_requests")
}

model AdminAuditLog {
  id          String   @id @default(uuid())
  actorUserId String?  @map("actor_user_id")
  action      String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  before      Json?
  after       Json?
  ipHash      String?  @map("ip_hash")
  createdAt   DateTime @default(now()) @map("created_at")

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id])

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("admin_audit_logs")
}
