generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DELETED

  @@map("account_status")
}

enum RoleName {
  GUEST
  HOST
  SELLER
  DRIVER
  ADMIN
  SUPPORT

  @@map("role_name")
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  PAUSED
  EXPIRED

  @@map("listing_status")
}

enum IdDocumentStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED

  @@map("id_document_status")
}

enum VehicleStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED

  @@map("vehicle_status")
}

enum VehicleCategory {
  BIKE
  ECONOMY
  COMFORT
  SUV
  VAN
  VIP
}

enum VehicleInspectionStatus {
  PENDING
  PASSED
  FAILED
  EXPIRED
}

enum AvailabilityStatus {
  BLOCKED
  AVAILABLE

  @@map("availability_status")
}

enum ListingDivision {
  STAYS
  RENTALS
  BUY
  CARS
  MARKETPLACE
  NEW_CONSTRUCTION

  @@map("listing_division")
}

enum BookingStatus {
  DRAFT
  REQUESTED
  PAYMENT_PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  DISPUTED

  @@map("booking_status")
}

enum PaymentStatus {
  PENDING_PROOF
  PENDING_ADMIN_REVIEW
  APPROVED
  REJECTED
  REFUNDED

  @@map("payment_status")
}

enum WalletEntryType {
  CREDIT
  DEBIT
  HOLD
  RELEASE
  REFUND

  @@map("wallet_entry_type")
}

enum GiftStatus {
  CREATED
  SENT
  CLAIM_PENDING
  CLAIMED
  LOCKED
  EXPIRED
  ADMIN_BLOCKED

  @@map("gift_status")
}

enum RideStatus {
  DRAFT
  REQUESTED
  MATCHING
  DRIVER_ASSIGNED
  DRIVER_ARRIVING
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED

  @@map("ride_status")
}

enum MessageSenderRole {
  GUEST
  HOST
  ADMIN
  SUPPORT
  DRIVER
  RIDER

  @@map("message_sender_role")
}

model User {
  id           String        @id @default(uuid())
  email        String?       @unique
  phoneHash    String?       @unique @map("phone_hash")
  passwordHash String?       @map("password_hash")
  displayName  String        @map("display_name")
  locale       String        @default("ar-SY")
  status       AccountStatus @default(ACTIVE)
  // SEC-002 security epoch. Every session token carries the epoch it was issued under; bumping
  // this column invalidates every outstanding token for this user in one atomic write (logout-all,
  // suspension, deletion, role change). See prisma/migrations/046_session_revocation.
  sessionEpoch Int           @default(0) @map("session_epoch")
  idDocumentRef String?      @map("id_document_ref")
  idDocumentSubmittedAt DateTime? @map("id_document_submitted_at")
  idDocumentMimeType String? @map("id_document_mime_type")
  idDocumentStatus IdDocumentStatus? @map("id_document_status")
  // Personal profile photo (migration 051). Stored like the ID document (object storage key + mime);
  // applies to any account (guest or host) for the profile section.
  avatarRef String? @map("avatar_ref")
  avatarMimeType String? @map("avatar_mime_type")
  idDocumentReviewedById String? @map("id_document_reviewed_by_id")
  idDocumentReviewedAt DateTime? @map("id_document_reviewed_at")
  // Host verification (migration 049): set when the host redeems an admin-issued activation code.
  // Stays owned by an account with this NULL are hidden from public listing endpoints and refused
  // by POST /api/bookings (server/lib/host-verification.mjs).
  hostVerifiedAt   DateTime? @map("host_verified_at")
  // SR in-ride audio recording preference (migration 063): OFF | ON_DEMAND | NIGHT_ONLY | EVERY_RIDE.
  // Lyft-parity safety feature; actual capture is additionally gated by SR_AUDIO_RECORDING_ENABLED.
  srRecordingMode  String?   @default("OFF") @map("sr_recording_mode")
  hostVerifiedById String?   @map("host_verified_by_id")
  // Stripe-for-SR Option B (saved-card auto-charge). The rider's Stripe Customer and their one saved
  // default card, captured once via a Checkout session in setup mode. Only non-sensitive descriptors
  // (brand + last4) are stored; the card itself lives at Stripe, referenced by the payment-method id.
  stripeCustomerId  String? @map("stripe_customer_id")
  defaultCardPmId   String? @map("default_card_pm_id")
  defaultCardBrand  String? @map("default_card_brand")
  defaultCardLast4  String? @map("default_card_last4")
  // Self-selected account "title" / type picked at sign-up: CLIENT, DRIVER, SELLER, BUYER, RENTER,
  // CAR_OWNER, HOST. This is a self-described intent shown on the profile and used to tailor the
  // experience / route onboarding -- it is NOT a privileged role grant (driver/seller still verify).
  title             String? @map("title")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  roles             UserRole[]
  sessions          UserSession[]
  sellerProfile     SellerProfile?
  hostProfile       HostProfile?
  driverProfile     DriverProfile?
  listings          Listing[]         @relation("ListingOwner")
  bookings          Booking[]         @relation("BookingGuest")
  wallets           Wallet[]
  sentGifts         WalletGift[]      @relation("GiftSender")
  claimedGifts      WalletGift[]      @relation("GiftRecipient")
  rideRequests      RideRequest[]     @relation("RideRider")
  driverRideMatches RideRequest[]     @relation("RideDriver")
  auditLogs         AdminAuditLog[]   @relation("AuditActor")
  listingReviews    ListingReview[]   @relation("ReviewGuest")
  rideReviews       RideReview[]      @relation("RideReviewRider")
  rideRecordings    RideRecording[]   @relation("RecordingUploader")
  sentMessages      Message[]         @relation("MessageSender")
  paymentProofs     PaymentProof[]    @relation("PaymentPayer")
  listingInquiries  MessageThread[]   @relation("ListingInquiryGuest")
  // Cars marketplace auction (migration 060): as seller, as winner, and placed bids.
  auctionsSelling   Auction[]         @relation("AuctionSeller")
  auctionsWon       Auction[]         @relation("AuctionWinner")
  bids              Bid[]             @relation("BidBidder")
  // Centris-parity Phase 1 (migration 061): saved listings + saved searches with new-listing alerts.
  favourites        Favourite[]       @relation("UserFavourites")
  savedSearches     SavedSearch[]     @relation("UserSavedSearches")
  // Schedule-a-visit (migration 062): visits this user requested, and visits for listings they own.
  visitsRequested   VisitRequest[]    @relation("VisitRequester")
  visitsToHost      VisitRequest[]    @relation("VisitOwner")
  // Agent reviews (migration 064): reviews written about this agent, and reviews this user authored.
  agentReviewsReceived AgentReview[]  @relation("AgentReviewed")
  agentReviewsWritten  AgentReview[]  @relation("AgentReviewAuthor")
  savedPlaces       SavedPlace[]
  promoRedemptions  PromoRedemption[]
  pushSubscriptions PushSubscription[]
  businessAccountMemberships BusinessAccountMember[]
  adminOfBusinessAccounts    BusinessAccount[]        @relation("BusinessAccountAdmin")
  refundsRequested             Refund[]        @relation("RefundRequestedBy")
  refundAttemptsLegacyAccepted RefundAttempt[] @relation("RefundAttemptLegacyAcceptedBy")
  payoutMethod                 HostPayoutMethod?
  payoutRequests               PayoutRequest[] @relation("PayoutRequestHost")
  payoutRequestsDecided        PayoutRequest[] @relation("PayoutRequestDecidedBy")
  hostVerifiedBy               User?           @relation("HostVerifiedBy", fields: [hostVerifiedById], references: [id], onDelete: SetNull)
  hostsVerified                User[]          @relation("HostVerifiedBy")
  hostActivationCodes          HostActivationCode[] @relation("HostActivationCodeHost")
  hostActivationCodesIssued    HostActivationCode[] @relation("HostActivationCodeIssuedBy")
  loyaltyAccount               LoyaltyAccount?
  merchants                    Merchant[]      @relation("MerchantOwner")
  foodOrders                   FoodOrder[]     @relation("FoodOrderCustomer")
  courierFoodOrders            FoodOrder[]     @relation("FoodOrderCourier")
  foodOrderMessages            FoodOrderMessage[] @relation("FoodOrderMessageSender")

  @@map("users")
}

// ============================================================================
// SE (Eats) — food & grocery delivery vertical (Phase 1, 2026-10-15).
// Separate customer app, SAME platform: one account, one driver fleet (couriers are DRIVER users),
// one admin. Phase 1 is cash-on-delivery only — wallet/ledger integration is an explicit later
// phase (AGENTS.md §6: money semantics never change as a side effect). Pricing is always computed
// server-side from the menu snapshot; a client can never supply a price.
// ============================================================================

enum MerchantStatus {
  PENDING_REVIEW
  APPROVED
  SUSPENDED
}

enum FoodOrderStatus {
  PLACED
  ACCEPTED
  PREPARING
  READY_FOR_PICKUP
  PICKED_UP
  DELIVERED
  CANCELLED
  REJECTED
}

// Menu Studio (migration 067): every uploaded photo is moderated. PENDING_REVIEW on upload;
// only APPROVED photos are ever shown to customers (fail-closed, like merchant approval).
enum FoodPhotoStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

model Merchant {
  id        String         @id @default(uuid())
  ownerId   String         @map("owner_id")
  name      String
  nameAr    String?        @map("name_ar")
  category  String         @default("restaurant")
  city      String
  address   String
  phone     String?
  status    MerchantStatus @default(PENDING_REVIEW)
  active    Boolean        @default(true)
  // Order experience (068): store position for the order map (plain lat/lng, display-only like
  // SavedPlace), the merchant's own busy switch, and their usual prep time.
  lat                Float?
  lng                Float?
  acceptingOrders    Boolean @default(true) @map("accepting_orders")
  defaultPrepMinutes Int?    @map("default_prep_minutes")
  // Opening hours + minimum order (072). openingHours null = always open (busy switch still applies).
  openingHours       Json?   @map("opening_hours")
  minOrderMinor      Int?    @map("min_order_minor")
  // Menu Studio (067): moderated cover photo. photoMeta holds the standards-check evidence
  // (dimensions, byte size, editor-signature heuristics) shown to the reviewing admin.
  photoRef         String?          @map("photo_ref")
  photoMimeType    String?          @map("photo_mime_type")
  photoStatus      FoodPhotoStatus? @map("photo_status")
  photoReviewNote  String?          @map("photo_review_note")
  photoMeta        Json             @default("{}") @map("photo_meta")
  photoSubmittedAt DateTime?        @map("photo_submitted_at")
  photoReviewedAt  DateTime?        @map("photo_reviewed_at")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  owner     User        @relation("MerchantOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  menuItems MenuItem[]
  orders    FoodOrder[]

  @@index([ownerId])
  @@index([status, active, city])
  @@index([photoStatus])
  @@map("merchants")
}

model MenuItem {
  id          String   @id @default(uuid())
  merchantId  String   @map("merchant_id")
  name        String
  nameAr      String?  @map("name_ar")
  description String?
  priceMinor  Int      @map("price_minor")
  currency    String
  available   Boolean  @default(true)
  sortOrder   Int      @default(0) @map("sort_order")
  // Menu Studio (067): moderated item photo — same review discipline as the merchant cover.
  photoRef         String?          @map("photo_ref")
  photoMimeType    String?          @map("photo_mime_type")
  photoStatus      FoodPhotoStatus? @map("photo_status")
  photoReviewNote  String?          @map("photo_review_note")
  photoMeta        Json             @default("{}") @map("photo_meta")
  photoSubmittedAt DateTime?        @map("photo_submitted_at")
  photoReviewedAt  DateTime?        @map("photo_reviewed_at")
  // Promotions (067): a time-windowed promo price. The EFFECTIVE price (promo when active, base
  // otherwise) is computed server-side at order time and snapshotted — explicit, tested money
  // semantics (AGENTS.md §6), never a client-supplied number.
  promoPriceMinor Int?      @map("promo_price_minor")
  promoLabel      String?   @map("promo_label")
  promoStartsAt   DateTime? @map("promo_starts_at")
  promoEndsAt     DateTime? @map("promo_ends_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  merchant   Merchant        @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  orderItems FoodOrderItem[]

  @@index([merchantId, available])
  @@index([photoStatus])
  @@map("menu_items")
}

model FoodOrder {
  id               String          @id @default(uuid())
  merchantId       String          @map("merchant_id")
  customerId       String          @map("customer_id")
  courierId        String?         @map("courier_id")
  status           FoodOrderStatus @default(PLACED)
  subtotalMinor    Int             @map("subtotal_minor")
  deliveryFeeMinor Int             @default(0) @map("delivery_fee_minor")
  serviceFeeMinor  Int             @default(0) @map("service_fee_minor")
  totalMinor       Int             @map("total_minor")
  currency         String
  paymentMethod    String          @default("cash") @map("payment_method")
  deliveryAddress  String          @map("delivery_address")
  deliveryLat      Float?          @map("delivery_lat")
  deliveryLng      Float?          @map("delivery_lng")
  // Order experience (068): 'delivery' | 'pickup' (pickup = no courier, no delivery fee);
  // etaAt = the promise shown to the customer (accept sets it, delay moves it); delayedCount > 0
  // reopens the customer's cancel right; scheduledFor = a "next time" order.
  fulfillment      String          @default("delivery")
  etaAt            DateTime?       @map("eta_at")
  delayedCount     Int             @default(0) @map("delayed_count")
  scheduledFor     DateTime?       @map("scheduled_for")
  notes            String?
  metadata         Json            @default("{}")
  acceptedAt       DateTime?       @map("accepted_at")
  readyAt          DateTime?       @map("ready_at")
  pickedUpAt       DateTime?       @map("picked_up_at")
  deliveredAt      DateTime?       @map("delivered_at")
  // Customer rating of a delivered order (072): 1..5 stars, once.
  ratingStars      Int?            @map("rating_stars")
  ratingComment    String?         @map("rating_comment")
  ratedAt          DateTime?       @map("rated_at")
  cancelledAt      DateTime?       @map("cancelled_at")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  merchant Merchant           @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  customer User               @relation("FoodOrderCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  courier  User?              @relation("FoodOrderCourier", fields: [courierId], references: [id], onDelete: SetNull)
  items    FoodOrderItem[]
  messages FoodOrderMessage[]

  @@index([merchantId, status])
  @@index([customerId])
  @@index([courierId])
  @@index([status])
  @@index([merchantId, ratingStars])
  @@map("food_orders")
}

model FoodOrderItem {
  id                 String  @id @default(uuid())
  orderId            String  @map("order_id")
  menuItemId         String? @map("menu_item_id")
  // Name/price SNAPSHOT at order time: a later menu edit must never change what an order says it
  // cost (same reasoning as SR's fareFactors audit trail).
  nameSnapshot       String  @map("name_snapshot")
  priceMinorSnapshot Int     @map("price_minor_snapshot")
  quantity           Int

  order    FoodOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("food_order_items")
}

// Order experience (068): per-order chat between customer, merchant owner and courier. Polled by
// the clients; senderRole recorded at send time so the transcript stays honest later.
model FoodOrderMessage {
  id         String   @id @default(uuid())
  orderId    String   @map("order_id")
  senderId   String   @map("sender_id")
  senderRole String   @map("sender_role")
  body       String
  createdAt  DateTime @default(now()) @map("created_at")

  order  FoodOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sender User      @relation("FoodOrderMessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("food_order_messages")
}

// Loyalty program (migration 051). Points are earned when a booking completes and can be redeemed
// for SYBNB wallet credit; tier is derived from lifetime points. Earn rates, tier thresholds and
// the redemption rate are owned by server/lib/loyalty.mjs (kept out of the schema so they stay
// country-/config-tunable).
enum LoyaltyTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM

  @@map("loyalty_tier")
}

enum LoyaltyEntryType {
  EARN
  REDEEM
  ADJUST

  @@map("loyalty_entry_type")
}

model LoyaltyAccount {
  id             String      @id @default(uuid())
  userId         String      @unique @map("user_id")
  pointsBalance  Int         @default(0) @map("points_balance")
  lifetimePoints Int         @default(0) @map("lifetime_points")
  tier           LoyaltyTier @default(BRONZE)
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries LoyaltyEntry[]

  @@map("loyalty_accounts")
}

model LoyaltyEntry {
  id            String           @id @default(uuid())
  accountId     String           @map("account_id")
  type          LoyaltyEntryType
  points        Int
  reason        String?
  referenceType String           @map("reference_type")
  referenceId   String           @map("reference_id")
  idempotencyKey String          @unique @map("idempotency_key")
  createdAt     DateTime         @default(now()) @map("created_at")

  account LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
  @@index([referenceType, referenceId])
  @@map("loyalty_entries")
}

// SEC-002 server-backed session. One row per issued session token; the token carries this row's id
// as its `sid` claim and every authenticated request re-reads the row. Revoking one row logs out
// exactly one session without disturbing that account's other devices.
model UserSession {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  issuedAt      DateTime  @default(now()) @map("issued_at")
  expiresAt     DateTime  @map("expires_at")
  revokedAt     DateTime? @map("revoked_at")
  revokedReason String?   @map("revoked_reason")
  lastUsedAt    DateTime? @map("last_used_at")
  userAgent     String?   @map("user_agent")
  createdAt     DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  role      RoleName
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([role])
  @@map("user_roles")
}

model SellerProfile {
  id             String        @id @default(uuid())
  userId         String        @unique @map("user_id")
  legalName      String        @map("legal_name")
  sellerType     String        @map("seller_type")
  documentStatus ListingStatus @default(DRAFT) @map("document_status")
  planCode       String?       @map("plan_code")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("seller_profiles")
}

model HostProfile {
  id            String   @id @default(uuid())
  userId        String   @unique @map("user_id")
  about         String?
  city          String?
  languages     String[] @default([])
  photoRef      String?  @map("photo_ref")
  photoMimeType String?  @map("photo_mime_type")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("host_profiles")
}

// Host withdrawal destination (money-flow decision 2, migration 048). One per host. `type` is one of
// the active country profile's payoutMethods keys (countries/<country>/profile.mjs), validated in
// server/routes/host.mjs -- kept a plain string so the master schema stays country-neutral; the
// per-type fields (wallet number, bank, office city...) live in `details` with only the keys that
// type requires.
model HostPayoutMethod {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  type      String
  details   Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("host_payout_methods")
}

enum PayoutRequestStatus {
  REQUESTED
  PAID
  REJECTED

  @@map("payout_request_status")
}

// A host's request to withdraw released wallet earnings (decision 2). Creating one moves no money.
// An admin pays the host OUTSIDE the platform and marks it PAID (one DEBIT wallet entry, linked via
// walletEntryId) or REJECTED with a note. `method` is a snapshot of the payout method at request time.
model PayoutRequest {
  id            String              @id @default(uuid())
  hostId        String              @map("host_id")
  amountMinor   Int                 @map("amount_minor")
  currency      String
  status        PayoutRequestStatus @default(REQUESTED)
  method        Json                @default("{}")
  reference     String?
  note          String?
  decidedById   String?             @map("decided_by_id")
  decidedAt     DateTime?           @map("decided_at")
  walletEntryId String?             @unique @map("wallet_entry_id")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  host        User         @relation("PayoutRequestHost", fields: [hostId], references: [id], onDelete: Restrict)
  decidedBy   User?        @relation("PayoutRequestDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict)
  walletEntry WalletEntry? @relation(fields: [walletEntryId], references: [id], onDelete: Restrict)

  @@index([hostId, status])
  @@index([status, createdAt])
  @@map("payout_requests")
}

// Admin-issued host activation code (migration 049). Only an HMAC of the 6-digit code is stored
// (same scheme as verification_codes, bound to host_id). At most one is live per host: issuing a new
// one retires the previous unused ones by moving their expires_at to the re-issue time. `attempts`
// counts wrong guesses; at HOST_ACTIVATION_MAX_ATTEMPTS the code is locked until re-issued.
model HostActivationCode {
  id         String    @id @default(uuid())
  hostId     String    @map("host_id")
  codeHash   String    @map("code_hash")
  issuedById String?   @map("issued_by_id")
  issuedAt   DateTime  @default(now()) @map("issued_at")
  expiresAt  DateTime  @map("expires_at")
  usedAt     DateTime? @map("used_at")
  attempts   Int       @default(0)

  host     User  @relation("HostActivationCodeHost", fields: [hostId], references: [id], onDelete: Cascade)
  issuedBy User? @relation("HostActivationCodeIssuedBy", fields: [issuedById], references: [id], onDelete: SetNull)

  @@index([hostId])
  @@map("host_activation_codes")
}

model DriverProfile {
  id              String   @id @default(uuid())
  userId          String   @unique @map("user_id")
  licenseHash     String?  @map("license_hash")
  vehicleMake     String?  @map("vehicle_make")
  vehicleModel    String?  @map("vehicle_model")
  vehiclePlate    String?  @map("vehicle_plate")
  vehicleStatus   VehicleStatus @default(PENDING_REVIEW) @map("vehicle_status")
  vehicleCategory VehicleCategory? @map("vehicle_category")
  vehicleYear     Int?     @map("vehicle_year")
  vehicleColor    String?  @map("vehicle_color")
  registrationExpiresAt DateTime? @map("registration_expires_at")
  inspectionStatus VehicleInspectionStatus @default(PENDING) @map("inspection_status")
  inspectionExpiresAt DateTime? @map("inspection_expires_at")
  photoRef        String?  @map("photo_ref")
  photoMimeType   String?  @map("photo_mime_type")
  active          Boolean  @default(false)
  accessibilityCapable Boolean @default(false) @map("accessibility_capable")
  lastLocationGeo Unsupported("geometry(Point,4326)")? @map("last_location_geo")
  lastLocationUpdatedAt DateTime? @map("last_location_updated_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("driver_profiles")
}

model Location {
  id          String   @id @default(uuid())
  country    String   @default("SY")
  governorate String
  city        String
  area        String?
  street      String?
  addressLine String?  @map("address_line")
  geo         Unsupported("geometry(Point,4326)")?
  lat         Float?
  lng         Float?
  createdAt   DateTime @default(now()) @map("created_at")

  listings       Listing[]
  pickupRides    RideRequest[] @relation("RidePickup")
  dropoffRides   RideRequest[] @relation("RideDropoff")

  @@index([governorate, city])
  @@map("locations")
}

model Listing {
  id          String          @id @default(uuid())
  ownerId     String          @map("owner_id")
  locationId  String?         @map("location_id")
  division    ListingDivision
  titleAr     String          @map("title_ar")
  titleEn     String?         @map("title_en")
  description String?
  status      ListingStatus   @default(DRAFT)
  priceMinor  Int             @map("price_minor")
  currency    String          @default("SYP")
  instantBookEnabled Boolean  @default(false) @map("instant_book_enabled")
  expiresAt   DateTime?       @map("expires_at")
  // Set when the listing transitions to APPROVED (migration 061). Powers new-listing alerts so they
  // fire on approval, not on draft creation. Null for listings approved before this migration.
  approvedAt  DateTime?       @map("approved_at")
  metadata    Json            @default("{}")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  owner          User                  @relation("ListingOwner", fields: [ownerId], references: [id])
  location       Location?             @relation(fields: [locationId], references: [id])
  media          ListingMedia[]
  bookings       Booking[]
  availability   ListingAvailability[]
  reviews        ListingReview[]
  inquiryThreads MessageThread[]
  // AI pre-check for the admin reviewer (migration 050). Never included unless asked for, so it
  // cannot leak through the many `include: { listing: true }` guest-facing responses.
  aiReview       ListingAiReview?
  // Cars marketplace auction (migration 060). A CARS listing may be sold by auction; the row's
  // existence is the source of truth for "this listing is an auction". Fixed-price listings have none.
  auction        Auction?
  // Users who saved this listing to their favourites (migration 061).
  favouritedBy   Favourite[]
  // Scheduled visit requests for this listing (migration 062).
  visitRequests  VisitRequest[]
  // Seller-published viewing windows (migration 064).
  openHouses     OpenHouse[]

  @@index([division, status])
  @@index([ownerId])
  // Backs GET /api/listings's keyset-paginated browse/search scan (server/routes/listings.mjs):
  // filters on (division, status), then walks pages ordered by (createdAt, id) DESC. Without the
  // trailing two columns each page's cursor comparison falls back to a full-bucket sort.
  @@index([division, status, createdAt, id])
  // Same reasoning, for sort=priceLow/priceHigh's price-ordered scan instead of the default
  // createdAt-ordered one.
  @@index([division, status, priceMinor, id])
  @@map("listings")
}

// Owner decision 2026-10-09: automatic AI check of a submitted listing, shown to the admin reviewer
// next to the listing. Advisory only -- the admin decides. See migration 050_listing_ai_review.
model ListingAiReview {
  id           String    @id @default(uuid())
  listingId    String    @unique @map("listing_id")
  status       String    @default("PENDING")
  model        String?
  runId        String?   @map("run_id")
  trigger      String?
  result       Json?
  error        String?
  startedAt    DateTime? @map("started_at")
  completedAt  DateTime? @map("completed_at")
  hostFeedback Json?     @map("host_feedback")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@map("listing_ai_reviews")
}

model ListingAvailability {
  id                 String              @id @default(uuid())
  listingId          String              @map("listing_id")
  date               DateTime            @db.Date
  status             AvailabilityStatus  @default(BLOCKED)
  priceOverrideMinor Int?                @map("price_override_minor")
  note               String?
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, date])
  @@index([listingId, date])
  @@map("listing_availability")
}

model ListingMedia {
  id        String   @id @default(uuid())
  listingId String   @map("listing_id")
  url       String
  kind      String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@map("listing_media")
}

model Booking {
  id          String        @id @default(uuid())
  listingId   String        @map("listing_id")
  guestId     String        @map("guest_id")
  status      BookingStatus @default(REQUESTED)
  checkIn     DateTime?     @map("check_in")
  checkOut    DateTime?     @map("check_out")
  amountMinor Int           @map("amount_minor")
  currency    String        @default("SYP")
  metadata    Json          @default("{}")
  guestCheckedInAt  DateTime? @map("guest_checked_in_at")
  guestCheckedOutAt DateTime? @map("guest_checked_out_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  listing  Listing       @relation(fields: [listingId], references: [id])
  guest    User          @relation("BookingGuest", fields: [guestId], references: [id])
  payments PaymentProof[]
  paymentIntents PaymentIntent[]
  paymentEvents PaymentEvent[]
  review   ListingReview?
  messageThread MessageThread?

  @@index([guestId, status])
  @@index([listingId, status])
  @@map("bookings")
}

model PaymentProof {
  id              String        @id @default(uuid())
  bookingId       String?       @map("booking_id")
  rideId          String?       @map("ride_id")
  userId          String        @map("user_id")
  provider        String
  status          PaymentStatus @default(PENDING_PROOF)
  amountMinor     Int           @map("amount_minor")
  currency        String        @default("SYP")
  proofAssetUrl   String?       @map("proof_asset_url")
  // Full set of uploaded evidence files (seller-plan/advertising submissions can carry several —
  // ownership proof, license, photos). proofAssetUrl stays populated with the first one for
  // backward compatibility with every existing single-file consumer (Stripe, local-wallet, etc.,
  // which only ever have one); this is the complete list admin should actually review.
  proofAssetUrls  String[]      @default([]) @map("proof_asset_urls")
  providerRef     String?       @map("provider_ref")
  // Which plan THIS payment was submitted for -- durable per-payment record, unlike
  // SellerProfile.planCode which gets overwritten by every new submission. Used to identify
  // advertising-tier payments specifically for the one-payment-per-campaign binding below.
  planCode        String?       @map("plan_code")
  // Set the moment an advertising payment is bound to a new campaign listing at creation
  // (deterministic campaign association, not inferred from amount/uploader). Stays set forever
  // once that campaign is admin-approved -- the payment is genuinely consumed. Released back to
  // NULL if the bound campaign is REJECTED instead, so the same payment can back a retry.
  campaignListingId String?     @map("campaign_listing_id")
  adminNote       String?       @map("admin_note")
  reviewedById    String?       @map("reviewed_by_id")
  reviewedAt      DateTime?     @map("reviewed_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  // Three separate refund counters -- reserved (held pending an in-flight refund), succeeded
  // (genuinely provider/ledger-confirmed), accepted (an owner's explicit acceptance of incomplete
  // legacy evidence, NEVER conflated with succeeded). The hard, unconditional cap
  // (reserved+succeeded+accepted <= amountMinor) is enforced by the refund_minor_within_amount
  // CHECK constraint at the database level, independent of any application-level eligibility policy.
  reservedRefundMinor  Int     @default(0) @map("reserved_refund_minor")
  succeededRefundMinor Int     @default(0) @map("succeeded_refund_minor")
  acceptedRefundMinor  Int     @default(0) @map("accepted_refund_minor")

  // Captured at original payment confirmation time -- 'charge' | 'payment_intent'. NULL for every
  // proof predating this column; refund creation on the stripe_checkout rail refuses to proceed
  // without these populated (an application-level check, not a DB constraint).
  providerPaymentObjectType String? @map("provider_payment_object_type")
  providerPaymentObjectId   String? @map("provider_payment_object_id")

  booking Booking?     @relation(fields: [bookingId], references: [id])
  ride    RideRequest? @relation(fields: [rideId], references: [id])
  payer   User         @relation("PaymentPayer", fields: [userId], references: [id])
  refunds Refund[]

  // A given provider reference may be submitted only once. Postgres treats NULLs as distinct, so
  // internally-generated proofs without a providerRef are unaffected; this closes the TOCTOU race
  // where two concurrent submissions with the same reference could both create a proof.
  @@unique([provider, providerRef], map: "payment_proofs_provider_provider_ref_key")
  @@index([status, createdAt])
  @@index([userId])
  // Scale-readiness audit: hit on ~10 route call sites (every booking screen loads its payment
  // proofs; the ride-payment duplicate-proof check filters by rideId directly) with no index
  // backing either FK -- confirmed a full sequential scan of this table before these were added.
  @@index([bookingId])
  @@index([rideId, status])
  @@index([campaignListingId])
  @@map("payment_proofs")
}

model ListingReview {
  id              String    @id @default(uuid())
  listingId       String    @map("listing_id")
  bookingId       String    @unique @map("booking_id")
  guestId         String    @map("guest_id")
  rating          Int
