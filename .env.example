# SYBNB V6 — environment template. Copy to .env and fill in real values.
# .env is git-ignored — never commit real secrets. This file must only ever contain placeholders.
# (Security audit finding F-16.)

# --- Database ---
# Local Postgres connection string. Never point this at a production database from a dev machine.
DATABASE_URL="postgresql://user@127.0.0.1:5432/sybnb_v6"
# On Vercel: use Neon's *pooled* connection string (the "-pooler" host Neon gives you), with
# ?pgbouncer=true&connect_timeout=15 appended -- serverless functions can spin up many concurrent
# instances, each opening its own DB connection; PgBouncer pooling is required to avoid exhausting
# Postgres's connection limit. Run `CREATE EXTENSION postgis;` once on the Neon database before
# `prisma migrate deploy` (see prisma/migrations/001_platform_foundation for what needs it).

# --- Vercel same-origin deployment ---
# Leave unset (or empty string) when the frontend and api/[...path].mjs are deployed together on
# the same Vercel project/domain -- requests become same-origin relative paths (/api/...) and CORS
# does not apply at all. Only set this to a separate URL if the API is ever split onto its own
# domain again (e.g. back onto a VPS) instead of Vercel serverless functions.
VITE_API_BASE_URL=""

# --- Auth secrets (server-side only, never exposed to the frontend) ---
# Any long random string. Rotating this invalidates every currently-issued session token.
AUTH_SECRET="replace-with-a-long-random-value"
# HMAC key used to hash phone numbers before storage. Also any long random string.
PHONE_HASH_SECRET="replace-with-a-different-long-random-value"

# --- Server ---
API_PORT=3051
API_HOST=127.0.0.1
# Comma-separated list of allowed frontend origins for CORS. In production this must be the real
# deployed frontend origin(s) — the built-in dev-only fallback list (127.0.0.1/localhost ports)
# must never be relied on outside local development.
CORS_ORIGIN="http://127.0.0.1:5180"

# --- Rate limiting (server/lib/rate-limit.mjs) ---
# Set to 1 only when this server sits behind a proxy/load balancer you control, so it's safe to
# trust the client-supplied X-Forwarded-For header for rate-limit bucketing. Leave unset/0 for
# local dev and any direct-exposed deployment. On Vercel: always set this to 1 -- every request
# already passes through Vercel's own edge proxy, so req.socket.remoteAddress is Vercel's internal
# infra address, not the real client IP; only x-forwarded-for has the real one.
TRUST_PROXY=0
# Set to 1 to disable rate limiting entirely (e.g. for local load testing). Never set this in
# production.
DISABLE_RATE_LIMIT=0
# KNOWN LIMITATION on Vercel: the rate limiter's counters are in-memory per function instance.
# Vercel runs many concurrent/short-lived instances, so the *effective* limit in production is
# looser than the numbers below suggest, and resets whenever a cold instance spins up -- it still
# blocks obvious abuse, but is not a precise global limit. Fixing this needs a shared store (Vercel
# KV / Upstash Redis) -- tracked as a known gap, not silently treated as solved.

# --- Production hardening flags ---
# Set to "production" to enable production-only behavior (currently: allows HSTS to be set).
NODE_ENV=development
# Set to 1 only once this server is actually served over HTTPS (typically via a reverse proxy
# terminating TLS in front of it) — setting this while served over plain HTTP would have browsers
# incorrectly remember to force HTTPS for this host.
FORCE_HTTPS=0

# --- Stripe ---
STRIPE_SECRET_KEY="sk_test_replace_me"
STRIPE_WEBHOOK_SECRET="whsec_replace_me"
STRIPE_CURRENCY="usd"
SYP_PER_USD=15000
# Publishable keys are designed to be public/client-exposed — this is intentionally VITE_-prefixed
# so Vite bundles it into the frontend build.
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_replace_me"

# --- AI insights (Anthropic) ---
# Real API key required for host pricing-insight generation to work; without it,
# POST /api/host/insights/generate returns a clear 503 AI_NOT_CONFIGURED error instead of
# simulating success.
ANTHROPIC_API_KEY="sk-ant-replace_me"

# --- Email delivery ---
# Two interchangeable providers; EMAIL_PROVIDER picks one explicitly ("resend" or "smtp"), or it's
# inferred from whichever credential below is set. Real credentials required for guest-signup
# verification emails and host-insight emails to actually send in production; without them the
# feature records the failure (or, outside production, returns a devCode instead) rather than
# pretending it succeeded.
EMAIL_PROVIDER="resend"
EMAIL_FROM="no-reply@replace-me.example"
EMAIL_FROM_NAME="SYBNB"
EMAIL_REPLY_TO="info@replace-me.example"

# Option A: Resend (https://resend.com) — simple HTTP API, no SMTP setup needed.
RESEND_API_KEY="re_replace_me"

# Option B: SMTP, via nodemailer — used when EMAIL_PROVIDER=smtp or RESEND_API_KEY is unset.
SMTP_HOST="smtp.replace-me.example"
SMTP_PORT=587
SMTP_USER="replace-me"
SMTP_PASS="replace-me"
SMTP_FROM="SYBNB <no-reply@replace-me.example>"
