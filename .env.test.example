# Template for the isolated local test-database environment.
# Copy to `.env.test` (already gitignored — never commit the real file) and fill in the values
# your local setup produced. See docs/testing/SYBNB_V6_TEST_DATABASE_SETUP.md for how to create
# the database/role this points at.
#
# This file must never point at the development database, production, or staging. The
# test-database safety guard (server/lib/test-db-guard.mjs) refuses to run any test that isn't
# backed by a value shaped like the placeholders below.

NODE_ENV=test

# Must be a dedicated, isolated database whose name ends in "_test", on localhost, using a
# role that has no access to any other database. Never the same value as your regular .env's
# DATABASE_URL.
DATABASE_URL=postgresql://sybnb_v6_test_role:REPLACE_WITH_YOUR_LOCAL_TEST_ROLE_PASSWORD@127.0.0.1:5432/sybnb_v6_test

# Test-only secrets — never reuse real AUTH_SECRET/PHONE_HASH_SECRET values here.
AUTH_SECRET=test-only-auth-secret-not-for-production-use-0001
PHONE_HASH_SECRET=test-only-phone-hash-secret-not-for-prod-0001

# Deliberately NOT setting DISABLE_RATE_LIMIT here: test/support/setup.mjs already raises the
# login/register limits to a generous value for functional tests, and the dedicated rate-limit
# test files (test/security/rate-limit-http.test.mjs, test/unit/rate-limit.test.mjs) need rate
# limiting genuinely active to verify 429 behavior — a global DISABLE_RATE_LIMIT=1 here would
# silently break those tests instead of testing the real thing.
