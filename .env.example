# SYBNB V6 API — required configuration (no real secret values in this file)
# Country selection (required; server fails closed if missing/unsupported/incomplete).
# The master platform is country-neutral; this selects the countries/<country> profile.
SYBNB_COUNTRY=syria
# Core (required in every environment; server fails closed without these):
AUTH_SECRET=change-me-long-random
PHONE_HASH_SECRET=change-me-long-random
DATABASE_URL=postgresql://user:password@host:5432/sybnb?schema=public
# SCALE/POOLING (production): size the pool so (replicas x connection_limit) stays under the DB/pooler
# max. Prisma reads these from the URL. Behind a pooler (PgBouncer/RDS Proxy/Accelerate) add
# `&pgbouncer=true`. Example: ...?schema=public&connection_limit=10&pool_timeout=20&pgbouncer=true
# RETENTION: run `node scripts/prune-expired-otps.mjs` on a schedule (e.g. daily) to prune expired
# verification codes (OTP_RETAIN_HOURS, default 24).
# API bind:
API_HOST=0.0.0.0
API_PORT=3051
# Production requires an explicit CORS origin (no wildcard fallback):
CORS_ORIGIN=https://your-frontend-domain.example
# Object storage (production must NOT use local disk):
STORAGE_PROVIDER=s3
STORAGE_S3_BUCKET=your-bucket
STORAGE_S3_REGION=your-region
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
# STORAGE_S3_ENDPOINT=            # optional, for GCS/MinIO/R2 S3-compatible endpoints
# STORAGE_S3_FORCE_PATH_STYLE=true
# SMS provider (production; sandbox by default). 'http' provider needs endpoint + key:
SMS_PROVIDER=sandbox
# SMS_HTTP_ENDPOINT=
# SMS_API_KEY=
# Email provider — REQUIRED in production. Email OTP is the primary auth channel (and the ONLY
# channel for email-only countries like Syria). 'sandbox' (default) sends nothing; production must
# use a live provider — the server FAILS CLOSED on sandbox email in production.
EMAIL_PROVIDER=sandbox
EMAIL_FROM=no-reply@your-domain.example
RESEND_API_KEY=
# Signature secret for the Resend inbound delivery/bounce webhook:
RESEND_WEBHOOK_SECRET=
# Payments (SANDBOX/TEST keys only until owner authorizes live activation):
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# Signature secret for the payment provider webhook (required when payments are active):
# PAYMENT_WEBHOOK_SECRET=
# Test-mode settlement currency for Stripe (SYP is not Stripe-settleable); USD by default:
# STRIPE_CURRENCY=USD
# Explicit kill switch (server/routes/payments.mjs): must be 'true' before a LIVE Stripe key will
# transact. Leave unset in production until the owner deliberately authorizes live payments.
# PAYMENTS_ENABLED=true
# Explicit kill switch (server/routes/payment-intents.mjs): must be 'true' before the electronic
# PaymentIntent/webhook system (intent creation, webhook processing, admin replay) is reachable at
# all. Default OFF, unconditionally — leave unset in production.
# PAYMENT_INTENTS_ENABLED=true
# NEVER set in production:
# OTP_EXPOSE_FOR_TEST=true
# STORAGE_ALLOW_LOCAL=true
# --- Payment policy (server/lib/payment-policy.mjs) -- every gate is default-deny -------------------
# Country payments gate: countries/<country>/profile.mjs gates.payments (Syria: 'disabled'). An
# explicit operator override, default unset (= profile decides). Owner decision only.
# SYBNB_PAYMENTS_GATE=enabled
# Divisions allowed to move money. Include PLATFORM: host withdrawal mark-paid, Stripe confirm
# (capture) and webhook intake are authorized under the division-neutral 'PLATFORM' division --
# without it every withdrawal mark-paid is refused (COUNTRY_DIVISION_NOT_ELIGIBLE).
# PAYMENT_POLICY_ELIGIBLE_DIVISIONS=STAYS,PLATFORM
# Stripe as an approved provider (owner decision 1, 2026-10-08). Default off.
# PAYMENT_PROVIDER_STRIPE_APPROVED=true
# Rail + per-operation switches, e.g. PAYMENT_RAIL_MANUAL_PROOF_ENABLED=true,
# PAYMENT_OPERATION_MANUAL_PROOF_PAYOUT_RELEASE_ENABLED=true (see scripts/run-all-e2e.sh for the full list).
# --- Booking money policy (defaults come from the country profile) ---------------------------------
# BOOKING_UNPAID_EXPIRY_HOURS=48
# BOOKING_FULL_REFUND_CUTOFF_HOURS=72
# BOOKING_EXPIRY_SWEEP_MINUTES=15
# BOOKING_QUOTE_RATE_MAX=120
# HOST_PAYOUT_REQUEST_RATE_MAX=10
# Optional: admin inbox for new payment proofs / payout requests / card payments on closed bookings.
# ADMIN_NOTIFY_EMAIL=
# Optional: public app URL used for links in notification emails.
# PUBLIC_APP_URL=https://your-frontend-domain.example
