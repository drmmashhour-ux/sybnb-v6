# SYBNB V6 — PRODUCTION environment template (RC e9dfd68)
# PLACEHOLDERS ONLY — never commit real secret values. Fill on the deploy host / secret manager.
# Startup validation (server/lib/env.mjs) FAILS CLOSED if any required var is missing/invalid.

NODE_ENV=production

# --- Core (required everywhere) ---
AUTH_SECRET=<LONG_RANDOM_64+_CHARS>
PHONE_HASH_SECRET=<LONG_RANDOM_64+_CHARS>
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<db>?schema=public

# --- API bind ---
API_HOST=0.0.0.0
API_PORT=3051

# --- Production-required ---
CORS_ORIGIN=https://<your-frontend-domain>          # exact origin(s), comma-separated, NO wildcard
STORAGE_PROVIDER=s3                                  # local disk is REFUSED in production
STORAGE_S3_BUCKET=<private-bucket>
STORAGE_S3_REGION=<region>
STORAGE_S3_ACCESS_KEY_ID=<key-id>
STORAGE_S3_SECRET_ACCESS_KEY=<secret>
# STORAGE_S3_ENDPOINT=<https://...>                 # optional: GCS/MinIO/R2 S3-compatible
# STORAGE_S3_FORCE_PATH_STYLE=true

# --- SMS (server-side OTP delivery) ---
SMS_PROVIDER=http                                    # 'sandbox' sends nothing
SMS_HTTP_ENDPOINT=<provider-endpoint>
SMS_API_KEY=<provider-key>

# --- Payments: DISABLED BY DEFAULT ---
# Leave UNSET to keep the live charge path off. Set TEST keys only for certification;
# live keys require a separate explicit owner authorization (reserved switch).
# STRIPE_SECRET_KEY=sk_test_<...>
PAYMENT_WEBHOOK_SECRET=whsec_<test-secret>

# --- MUST NOT be set in production (validation rejects) ---
# OTP_EXPOSE_FOR_TEST=true
# STORAGE_ALLOW_LOCAL=true

# Public access: gated at the DNS/edge layer, NOT here — keep closed until the reserved
# cutover authorization. This file does not open public access.
