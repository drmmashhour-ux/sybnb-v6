# SYBNB V6 — environment template. Copy to .env and fill real values.
# NEVER commit a real .env (see .gitignore). All secrets are env-driven; the API
# and auth layer hard-fail if AUTH_SECRET / PHONE_HASH_SECRET are unset.

# --- Database (PostgreSQL + PostGIS required) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/sybnb"

# --- API server ---
API_HOST=0.0.0.0
API_PORT=3051
# Comma-separated allowlist of browser origins permitted by CORS.
CORS_ORIGIN="https://your-frontend-domain.example"

# --- Frontend build (baked into the Vite bundle at build time) ---
VITE_API_BASE_URL="https://your-api-domain.example"

# --- Secrets (generate long random values, e.g. `openssl rand -hex 32`) ---
AUTH_SECRET="change-me-long-random-secret"
PHONE_HASH_SECRET="change-me-long-random-secret"

# --- Rate limiting (optional; sane defaults applied if unset) ---
# Max auth attempts (login/register) per window, per IP.
RATE_LIMIT_AUTH_MAX=10
# Max sensitive payment-proof submissions per window, per IP.
RATE_LIMIT_PAYMENT_MAX=20
# Window length in seconds.
RATE_LIMIT_WINDOW_SECONDS=60

# --- Stripe (card payments; leave unset to disable the card path — routes 503) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_CURRENCY="usd"
# Placeholder FX until a live feed is wired — do NOT use for real money at scale.
SYP_PER_USD=15000
