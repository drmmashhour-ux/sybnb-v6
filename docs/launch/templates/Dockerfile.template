# SYBNB V6 — container build TEMPLATE (RC e9dfd68). No secrets baked in.
# Secrets are injected at RUN time via env/secret manager, never via ARG/ENV in the image.
# Build the exact release: docker build -t sybnb:e9dfd68 .
FROM node:22-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npx prisma generate && npm run build

FROM node:22-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
# Copy only what the runtime needs:
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY --from=build /app/server ./server
COPY --from=build /app/prisma ./prisma
COPY --from=build /app/package.json ./package.json
# Run migrations as a SEPARATE deploy step (not in the image):
#   docker run --env-file production.env sybnb:e9dfd68 npx prisma migrate deploy
EXPOSE 3051
# Node receives SIGTERM directly for graceful shutdown:
STOPSIGNAL SIGTERM
CMD ["node", "server/index.mjs"]
